# THD Engenharia · site estático (substitui o WordPress)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # força HTTPS e domínio sem www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://thdengenharia.com%{REQUEST_URI} [L,R=301]

  # URLs antigas do WordPress → páginas novas
  RewriteRule ^home-bkp/?$ / [L,R=301]
  RewriteRule ^quem-somos-bkp/?$ /quem-somos/ [L,R=301]
  RewriteRule ^author/ / [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
  RewriteRule ^wp-login\.php$ / [L,R=301]

  # URLs sem barra final → com barra (/servicos → /servicos/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  # CSS e JS levam ?v=hash no link, então podem ficar em cache por muito tempo
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
